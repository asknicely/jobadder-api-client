    "type": "library",
    "require": {
        "php": "^7.4.0|^8.0",
        "php-http/client-common": "^1.0|^2.6",
        "psr/http-message": "^1.0",
        "symfony/serializer": "^2.8|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Dominic Scheirlinck",
            "email": "dominic@asknice.ly"
        },
        {
            "name": "Aaron Cooper",
