{
    "name": "varspool/jobadder-api-client",
    "description": "JobAdder API Client",
    "type": "library",
    "require": {
        "php": ">=7.4.0",
        "guzzlehttp/guzzle": "^7.0",
        "jane-php/open-api-runtime": "^7.4",
        "psr/log": "^1.0",
        "psr/http-message": "^1.0",
        "symfony/serializer": "^5.4",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.0",
        "jane-php/open-api-2": "^v7.4",
        "phpunit/phpunit": "^9.5",
        "phpunit/php-invoker": "^3.1"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Dominic Scheirlinck",
            "email": "dominic@asknice.ly"
        },
        {
            "name": "Aaron Cooper",
            "email": "aaron.cooper@asknice.ly"
        }
    ],
    "autoload": {
        "psr-4": {
            "Varspool\\JobAdder\\": "src/",
            "Varspool\\JobAdder\\V2\\": "generated/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Varspool\\JobAdder\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
